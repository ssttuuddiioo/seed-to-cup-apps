# Copy this file to .env.local and fill in. .env.local is gitignored.
# Source values from the Supabase dashboard (Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser.
# Used by scripts/seed.ts to upsert reference data.
SUPABASE_SERVICE_ROLE_KEY=
